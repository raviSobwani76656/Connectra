# Supabase project URL. Find it: Supabase dashboard > Project Settings > API. Public: sent to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon/publishable key; browser-safe only because Row Level Security restricts it. Find it: Supabase dashboard > Project Settings > API Keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role/secret key; bypasses Row Level Security. SERVER-ONLY, account deletion only. Find it: Supabase dashboard > Project Settings > API Keys.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64, for AES-256-GCM. SERVER-ONLY. Generate locally in PowerShell: $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
ENCRYPTION_KEY=
# Google OAuth 2.0 client ID. Find it: Google Cloud Console > APIs & Services > Credentials > your OAuth client.
GOOGLE_CLIENT_ID=
# Google OAuth 2.0 client secret. SERVER-ONLY. Find it: Google Cloud Console > APIs & Services > Credentials > your OAuth client.
GOOGLE_CLIENT_SECRET=
# Base URL of this app, used to build the OAuth redirect URI. Set it yourself per environment (local default below).
APP_URL=http://localhost:3000
